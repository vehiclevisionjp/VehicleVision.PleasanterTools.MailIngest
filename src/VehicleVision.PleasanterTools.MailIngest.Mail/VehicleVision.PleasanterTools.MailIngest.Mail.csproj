<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VehicleVision.PleasanterTools.MailIngest.Core\VehicleVision.PleasanterTools.MailIngest.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIME の構造化パーサー。MIT。MailKit（受信。#64）が伴う版と同じ。Core.Mail（送信部品）は参照しない -->
    <PackageReference Include="MimeKit" Version="4.18.1" />
    <!-- IMAP / POP3 の受信。MIT。MimeKit と同じ版。Core.Mail（送信部品）は参照しない -->
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- MimeKit が伴う System.Security.Cryptography.Pkcs 10.0.0 には既知の脆弱性（GHSA-846f-f764-76mx・GHSA-2fmv-rv2c-59x7）がある。
         修正版（Core.Data が使う版と同じ）へ固定する（直接参照。AtomFeed と同じ扱い） -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VehicleVision.PleasanterTools.MailIngest.Core.Tests" />
  </ItemGroup>

</Project>
